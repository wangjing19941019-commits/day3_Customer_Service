# 日志详细程度
debug=true
# JWT 签名密钥（敏感，无默认值）
secret_key=change-me
# 监听地址
host=127.0.0.1
# 监听端口（Agent 验证 8099）
port=8099
# CORS 来源，须含 5199 与 5175
cors_origins=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]
# SQLite 相对 backend/ 的路径
database_path=data/Customer_Service.db
# 临时上传目录
upload_dir=data/uploads
# 唯一共享登录名（旧账号保留，补 role=employee）
shared_username=it-help
# 仅首次启动写入哈希（敏感，无默认值）
shared_password=change-me
# 十个角色种子账号共用口令，只首次哈希（敏感，无默认值）
seed_password=change-me
# 登录 JWT 有效期（分钟）
jwt_expire_minutes=720
# 百炼 API Key（敏感，无默认值；本任务不调用）
llm_api_key=your-llm-api-key
# 百炼 OpenAI 兼容地址
llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型
llm_model=qwen-plus
# 采样温度
llm_temperature=0.2
# 单次 Chat/Embedding 超时秒数
llm_timeout_seconds=45
# 超时/429 最大重试次数
llm_max_retries=2
# 向量模型
embedding_model=text-embedding-v4
# 向量维度
embedding_dimensions=1024
# 嵌入批大小（不超过官方 10）
embedding_batch_size=10
# 上传上限字节
max_upload_bytes=5242880
# 分块最大字符
chunk_max_chars=800
# 分块重叠字符（单块上限 800 的 20%）
chunk_overlap_chars=160
# 单次打标输入上限
ingest_max_chars=24000
# 改写用会话条数
context_message_limit=20
# FAQ 命中阈值
faq_hit_threshold=0.82
# 召回条数
retrieve_top_k=5
# 召回下限
retrieve_min_score=0.55
# 召回融合余弦权重
retrieve_cosine_weight=0.7
# 召回融合关键词权重
retrieve_keyword_weight=0.3
# 抽取高置信分数下限
extract_high_confidence_min=0.8
# 在岗心跳秒数
on_duty_seconds=300
# SLA 扫描间隔秒数
sla_scan_seconds=60
# 灰度百分比
template_gray_percent=5
# 灰度评测集最少条数
eval_min_items=5000
# 拦截率告警升高幅度
alert_intercept_delta=0.20
# 告警窗口最少润色次数
alert_intercept_min_n=10
# 告警窗口分钟
alert_window_minutes=30
# 订单中心适配器地址（空则 Mock）
order_center_base_url=
# 仓储适配器地址（空则 Mock）
warehouse_base_url=
# 财务适配器地址（空则 Mock）
finance_base_url=
# 会员适配器地址（空则 Mock）
member_base_url=
# 物流适配器地址（空则 Mock）
logistics_base_url=
# SLA 规则 JSON，数字须与 PRD 一致
sla_rules={}
# 进行中文档拉取间隔（毫秒）
poll_interval_ms=3000
# ingesting 超时后启动时标失败（秒）
ingest_stale_seconds=300
# PRD 固定兜底原文
fallback_reply=抱歉，这个问题我暂时无法根据现有知识准确回答。你可以换个说法再问，或点击转人工。
# 反问上限轮次
clarification_max_rounds=5
# 坐席知识推送条数上限
agent_knowledge_top_k=3
