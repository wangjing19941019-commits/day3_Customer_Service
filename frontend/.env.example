# 业务请求相对路径，开发环境必须为 /api，禁止写成完整后端 URL
VITE_API_BASE_URL=/api

# 仅供 Vite 开发代理使用，不进入浏览器业务代码
VITE_BACKEND_PROXY_TARGET=http://localhost:8099

# true 使用 frontend/src/mocks；false 走 Vite 代理到真实后端。未设置时仍默认 true，联调必须为 false 并重启 Vite
VITE_USE_MOCK=false

# 与后端 poll 对齐的拉取间隔（毫秒）；本任务未使用
VITE_POLL_INTERVAL_MS=3000
